{
  "name": "pos-ferreteria-servidor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:crear": "tsx --env-file=.env src/crear-base.ts",
    "migrar": "tsx --env-file=.env src/migrar-cli.ts",
    "dev": "tsx watch --env-file=.env src/servidor.ts",
    "start": "tsx --env-file=.env src/servidor.ts",
    "terminal:crear": "tsx --env-file=.env src/crear-terminal.ts",
    "humo": "tsx --env-file=.env src/humo.ts",
    "humo:timbrar": "tsx --env-file=.env src/humo-timbrar.ts",
    "humo:descuento": "tsx --env-file=.env src/humo-descuento.ts",
    "humo:pos": "tsx --env-file=.env src/humo-pos.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^9",
    "fastify": "^5",
    "nodemailer": "^6.9.16",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}

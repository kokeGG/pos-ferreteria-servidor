# Copiar a `.env` y llenar. `.env` no se sube a git.
#
# Contraseña del Postgres local (la usa docker-compose y DATABASE_URL).
# Genera una con:  openssl rand -hex 16
POSTGRES_PASSWORD=
DATABASE_URL=postgres://pos:<POSTGRES_PASSWORD>@127.0.0.1:5433/pos_demo
# Base aparte para las pruebas automáticas (se crea sola, se vacía en cada corrida).
TEST_DATABASE_URL=postgres://pos:<POSTGRES_PASSWORD>@127.0.0.1:5433/pos_test

# Firma de los tokens de sesión. Mínimo 32 caracteres.
# Genera una con:  openssl rand -hex 32
JWT_SECRET=

PORT=3000
HOST=127.0.0.1

# Carpeta de archivos (XML/PDF de los CFDI y actualizador). Por omisión ./almacen.
# ALMACEN_DIR=almacen

# --- timbrar (fase 5) -------------------------------------------------------
# Sin estas, POST /timbrar responde 501. NUNCA pongas aquí llaves de PRODUCCIÓN:
# el servidor de la demo solo acepta el sandbox y se niega a arrancar con
# cualquier otra URL de Factura.com.
# PAC_PROVEEDOR=facturacom
# FACTURACOM_API_KEY=
# FACTURACOM_SECRET_KEY=
# FACTURACOM_BASE_URL=https://sandbox.factura.com/api
#
# Emisor (el RFC y el CSD de pruebas que tenga cargados el sandbox):
# CFDI_EMISOR_RFC=
# CFDI_EMISOR_NOMBRE=
# CFDI_EMISOR_REGIMEN=
# CFDI_EMISOR_CP=
#
# Correo (opcional). Gmail con "contraseña de aplicación", no la normal:
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CORREO_REMITENTE_NOMBRE=
# CORREO_RESPONDER_A=
